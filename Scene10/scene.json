签\n        value: 10,\n        min: 1,\n        max: 100,\n        integer: false\n    })\n    .finish();\n\nlet initScale, newScale, hover = false, propertyCheck = true, speed;\n\nexport function update(value) {\n    if (hover) {\n        value = new Vec3(\n            WEMath.mix(value.x, newScale.x, speed),\n            WEMath.mix(value.y, newScale.y, speed),\n            WEMath.mix(value.z, newScale.z, speed)\n        );\n    } else {\n        value = new Vec3(\n            WEMath.mix(value.x, initScale.x, speed),\n            WEMath.mix(value.y, initScale.y, speed),\n            WEMath.mix(value.z, initScale.z, speed)\n        );\n    }\n    return value;\n}\n\nexport function init(value) {\n    initScale = value;\n    return value;\n}\n\nexport function cursorEnter(event) {\n    hover = true;\n}\n\nexport function cursorLeave(event) {\n    hover = false;\n}\n\nexport function applyUserProperties(changedUserProperties) {\n    if (scriptProperties.hoScale != undefined && propertyCheck) {\n        newScale = new Vec3(initScale.multiply(scriptProperties.hoScale));\n        speed = scriptProperties.speed/100;\n        propertyCheck = false;\n    }\n}\n","scriptproperties":{"hoScale":1.2,"speed":10},"value":"0.75000 0.75000 1.00000"},"text":{"script":"'use strict';\n// Please note: Do not remove this line or asset references may break.\nexport let __workshopId = '3489089062';\n// Please note: Do not remove this line or asset references may break.\n// Please note: Do not remove this line or asset references may break.\n\nexport var scriptProperties = createScriptProperties()\n    .addCheckbox({\n        name: 'use24hFormat',\n        label: '24小时制',\n        value: true\n    })\n    .addText({\n        name: 'delimiter',\n        label: '分隔符',\n        value: ':'\n    })\n    .finish();\n\nexport function update(value) {\n    let time = new Date();\n    var hours = time.getHours();\n    let showLeadingZero = scriptProperties.use24hFormat;\n    \n    // 定义不同空格类型\n    const numberSpace = '\\u200B';    // 数字间窄空格 \\u2009\n    const beforeColon = '\\u200A'; // :前四分之一空格\n    const afterColon = '\\u200A';     // :后普通空格\n\n    if (!scriptProperties.use24hFormat) {\n        hours %= 12;\n        if (hours == 0) hours = 12;\n    }\n    \n    // 处理小时部分（数字间加窄空格）\n    hours = showLeadingZero ? (\"00\" + hours).slice(-2) : hours.toString();\n    let spacedHours = hours.toString().split('').join(numberSpace);\n    \n    // 处理分钟部分（数字间加窄空格）\n    let minutes = (\"00\" + time.getMinutes()).slice(-2);\n    let spacedMinutes = minutes.split('').join(numberSpace);\n    \n    // 组合最终格式（5 : 1 7）\n    return spacedHours + beforeColon + scriptProperties.delimiter + afterColon + spacedMinutes;\n}\n","scriptproperties":{"delimiter":":","use24hFormat":true},"value":"4 :53"},"maxrows":1,"depthtest":"enabled","backgroundbrightness":1,"castshadow":false},{"color":"0.45882 0.08627 0.05882","blockalign":false,"horizontalalign":"center","limituseellipsis":false,"padding":32,"verticalalign":"center","limitwidth":false,"disablepropagation":false,"pointsize":5,"origin":"0.00000 -54.06921 0.00000","name":"Date","opaquebackground":false,"anchor":"none","backgroundcolor":"0.00000 0.00000 0.00000","angles":"0.00000 -0.00000 0.00000","id":701,"font":"systemfont_arial","clampuvs":true,"parent":698,"size":"66.00000 24.00000","maxwidth":500,"limitrows":false,"scale":"1.25000 1.25000 1.00000","text":{"script":"'use strict';\n// Please note: Do not remove this line or asset references may break.\nexport let __workshopId = '3489089062';\n// Please note: Do not remove this line or asset references may break.\n\nexport function update(value) {\n    let time = new Date();\n    let months = [\n        'J\\u200Aa\\u200An',  // J a n\n        'F\\u200Ae\\u200Ab',  // F e b\n        'M\\u200Aa\\u200Ar',  // M a r\n        'A\\u200Ap\\u200Ar',  // A p r\n        'M\\u200Aa\\u200Ay',  // M a y\n        'J\\u200Au\\u200An',  // J u n\n        'J\\u200Au\\u200Al',  // J u l\n        'A\\