fects/shimmer/effect.json","name":"","visible":true}],"origin":{"script":"'use strict';\n// Please note: Do not remove this line or asset references may break.\nexport let __workshopId = '3489089062';\n\nexport var scriptProperties = createScriptProperties()\n    .addCheckbox({\n        name: 'isMovable',\n        label: 'Is movable/可拖动',\n        value: false\n    })\n    .finish();\n\nconst storageName = \"storedPosRoundMIC\";\nlet isDragging = false, dragOffset, timer;\n\n// 重置位置的函数\nexport function resetPosition() {\n    localStorage.remove(storageName); // 清除存储的位置\n    thisLayer.origin = thisLayer.originalOrigin; // 恢复初始位置\n}\n\nexport function cursorDown(event) {\n    if (!scriptProperties.isMovable || !shared.miDragable) return;\n    \n    timer = Date.now();\n    isDragging = true;\n    dragOffset = thisLayer.origin.subtract(event.worldPosition);\n}\n\nexport function cursorUp(event) {\n    isDragging = false;\n    if (scriptProperties.isMovable && shared.miDragable) {\n        localStorage.set(storageName, thisLayer.origin);\n    }\n}\n\nexport function cursorMove(event) {\n    if (!isDragging || !scriptProperties.isMovable || !shared.miDragable) return;\n    \n    const overClick = Date.now() - timer > 50;\n    if (!overClick) dragOffset = thisLayer.origin.subtract(event.worldPosition);\n    \n    thisLayer.origin = event.worldPosition.add(dragOffset);\n}\n\nexport function init() {\n    // 初始化拖动状态\n    shared.miDragable = localStorage.get(\"miDragable\") ?? scriptProperties.isMovable;\n    \n    // 尝试从存储中获取位置\n    const storedPos = localStorage.get(storageName);\n    \n    // 如果存储中有位置数据且启用了拖动，则应用存储的位置\n    if (shared.miDragable && storedPos) {\n        thisLayer.origin = storedPos;\n    }\n    \n    // 返回当前层的位置\n    return thisLayer.origin;\n}\n","scriptproperties":{"isMovable":{"value":true,"user":"clickontheclocktodrapit"}},"value":"1920.00000 2051.35449 0.00000"},"name":"D a y","opaquebackground":false,"anchor":"none","backgroundcolor":"0.00000 0.00000